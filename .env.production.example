# Production environment for the Lightsail instance.
#
# Copy to .env on the server and fill in. Never commit the filled copy —
# .env is gitignored, this template is not.
#
#   cp .env.production.example .env && nano .env
#
# Every value below is read by docker-compose.prod.yml. The application
# validates the security-relevant ones on startup under the prod profile and
# refuses to serve if any is wrong, rather than running insecurely.

# --- The hostname ----------------------------------------------------------
# Must already resolve to this instance's static IP before TLS is requested;
# a certificate cannot be issued for a bare IP address.
#
# Read by the backend as its allowed CORS origin, and by Caddy as the host to
# get a certificate for when the edge-tls profile is used.
DOMAIN=attendance.shareindiainsurance.com

# Only used by Caddy, under the edge-tls profile. Still has to be set either
# way: compose interpolates variables for every service, including ones a
# profile keeps from starting.
ACME_EMAIL=it.ins@shareindia.co.in

# --- Where the SPA is published on the host --------------------------------
# Loopback only. A reverse proxy already running on this instance points at
# this port; nothing outside the box can reach it.
#
# 8081 rather than 8080, which on a shared instance is the port something
# else has most likely taken.
FRONTEND_PORT=8081

# --- Database ---------------------------------------------------------------
# Not published to the host in production; reachable only on the compose
# network. These still need real values — MySQL initialises from them.
DB_NAME=attendance_db
DB_USERNAME=attendance_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- JWT --------------------------------------------------------------------
# Must base64-decode to at least 64 bytes. Generate with:
#   openssl rand -base64 64
# The application refuses to start on the committed placeholder.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Application ------------------------------------------------------------
COMPANY_TIMEZONE=Asia/Kolkata

# --- Not set here -----------------------------------------------------------
# SPRING_PROFILES_ACTIVE, REFRESH_COOKIE_SECURE, SWAGGER_ENABLED and
# CORS_ALLOWED_ORIGINS are fixed in docker-compose.prod.yml, and bcrypt
# strength is fixed at 12 in application.yml. These are security decisions
# rather than deployment settings: leaving them overridable from a file on
# the server is how a production box ends up serving Swagger.
#
# MYSQL_ROOT_PASSWORD and DB_PASSWORD are read by MySQL only when it first
# initialises its data directory. Changing them later edits this file and
# nothing else — the database keeps the old ones and the backend stops being
# able to connect. Changing them for real means an ALTER USER inside the
# running container, or discarding the volume and restoring from a dump.
