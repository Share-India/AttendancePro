# Production environment for the Lightsail instance.
#
# Copy to .env on the server and fill in. Never commit the filled copy —
# .env is gitignored, this template is not.
#
#   cp .env.production.example .env && nano .env
#
# Every value below is read by docker-compose.prod.yml. The application
# validates the security-relevant ones on startup under the prod profile and
# refuses to serve if any is wrong, rather than running insecurely.

# --- Which compose files apply ----------------------------------------------
# Compose reads this from .env, so a plain `docker compose up -d` or
# `docker compose down` picks up the production overlay automatically.
#
# Without it, those commands use only the base file — which publishes no host
# ports, so the reverse proxy loses its upstream and every page becomes a 502.
# That is a confusing failure, because the containers are all running happily.
#
# Colon-separated on Linux. On Windows it would be a semicolon.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- The hostname ----------------------------------------------------------
# Must already resolve to this instance's static IP before TLS is requested;
# a certificate cannot be issued for a bare IP address.
#
# Read by the backend as its allowed CORS origin, and by Caddy as the host to
# get a certificate for when the edge-tls profile is used.
DOMAIN=attendance.shareindiainsurance.com

# Only used by Caddy, under the edge-tls profile. Still has to be set either
# way: compose interpolates variables for every service, including ones a
# profile keeps from starting.
ACME_EMAIL=it.ins@shareindia.co.in

# --- Where the SPA is published on the host --------------------------------
# Loopback only. A reverse proxy already running on this instance points at
# this port; nothing outside the box can reach it.
#
# 8081 rather than 8080, which on a shared instance is the port something
# else has most likely taken.
FRONTEND_PORT=8081

# --- Database ---------------------------------------------------------------
# Not published to the host in production; reachable only on the compose
# network. These still need real values — MySQL initialises from them.
DB_NAME=attendance_db
DB_USERNAME=attendance_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- JWT --------------------------------------------------------------------
# Must base64-decode to at least 64 bytes. Generate with:
#   openssl rand -base64 64
# The application refuses to start on the committed placeholder.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Mail -------------------------------------------------------------------
# New joiners and password resets are sent a one-time link to choose their own
# password; approvals and request outcomes are emailed too. Nothing is mailed
# while MAIL_ENABLED is false — the message is logged instead, which is how to
# test the flow without reaching a real inbox.
#
# Leave this false until DOMAIN below actually serves the application. Every
# link in every message points at it, and a setup link is spent the first time
# it is opened: mail sent early burns one-time tokens on a dead URL.
MAIL_ENABLED=false

# Confirmed against the server: STARTTLS on 587, AUTH PLAIN LOGIN, valid
# Let's Encrypt certificate. Port 465 would need different properties.
#
# It must be mail.shareindia.co.in, not webmail.shareindia.co.in. They are the
# same machine on the same IP, but the provider serves whichever certificate is
# asked for by name: mail. presents one covering both mail. and webmail.,
# while webmail. presents one for cp01.premierdc.in alone. Since the client
# verifies the server's identity, webmail. fails TLS and sends nothing.
#
# webmail.shareindia.co.in:2096 is the browser interface — a different thing.
#
# AWS throttles outbound port 25 by default. 587 is not blocked, but check
# before relying on it:
#   timeout 5 bash -c 'exec 3<>/dev/tcp/mail.shareindia.co.in/587' && echo ok
MAIL_HOST=mail.shareindia.co.in
MAIL_PORT=587
MAIL_USERNAME=
# Never commit this. On shared hosting it is the mailbox password, so treat it
# as giving full access to that mailbox, not just the ability to send.
MAIL_PASSWORD=

# Must be a mailbox the server accepts mail from — generally the authenticated
# account itself, not an alias, or the server refuses it as relaying.
MAIL_FROM=
MAIL_FROM_NAME=Share India Attendance

# Where links in mail point. No trailing slash. Wrong here produces mail that
# looks correct and whose every link is broken, so startup refuses a value that
# is not an absolute http(s) URL.
APP_BASE_URL=https://attendance.shareindiainsurance.com

# How long a new joiner's "set your password" link lasts. Longer than the
# 30-minute reset link on purpose: it goes to people who may be on leave or
# will not open work mail until Monday.
SETUP_TOKEN_VALIDITY_HOURS=72

# --- Application ------------------------------------------------------------
COMPANY_TIMEZONE=Asia/Kolkata

# --- Not set here -----------------------------------------------------------
# SPRING_PROFILES_ACTIVE, REFRESH_COOKIE_SECURE, SWAGGER_ENABLED and
# CORS_ALLOWED_ORIGINS are fixed in docker-compose.prod.yml, and bcrypt
# strength is fixed at 12 in application.yml. These are security decisions
# rather than deployment settings: leaving them overridable from a file on
# the server is how a production box ends up serving Swagger.
#
# MYSQL_ROOT_PASSWORD and DB_PASSWORD are read by MySQL only when it first
# initialises its data directory. Changing them later edits this file and
# nothing else — the database keeps the old ones and the backend stops being
# able to connect. Changing them for real means an ALTER USER inside the
# running container, or discarding the volume and restoring from a dump.
